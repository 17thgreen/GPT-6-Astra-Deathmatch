          ]
        },
        "t_minus_7d_utc": {
          "type": "string"
        },
        "sot_pin": {
          "type": "string",
          "description": "Must equal kalshi_occurrence_datetime that drove windows"
        },
        "panel_version": {
          "type": "string"
        },
        "external_odds_present": {
          "type": "boolean"
        },
        "edge_at_quote": {
          "type": [
            "number",
            "null"
          ]
        },
        "edge_at_fill": {
          "type": [
            "number",
            "null"
          ]
        },
        "hedge_complete_flag": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "odds_age_sec": {
          "type": [
            "number",
            "null"
          ]
        },
        "fee_model_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "de_vig_method": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "proportional",
                "shin",
                "other"
              ]
            }
          ]
        },
        "edge_lost_cancel": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "hedge_complete_flag": {
                "type": "boolean"
              }
            }
          },
          "then": {
            "required": [
              "fee_model_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "external_odds_present": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "edge_at_quote": {
                "type": "null"
              },
              "edge_at_fill": {
                "type": "null"
              },
              "hedge_complete_flag": {
                "type": "null"
              },
              "odds_age_sec": {
                "type": "null"
              }
            }
          }
        }
