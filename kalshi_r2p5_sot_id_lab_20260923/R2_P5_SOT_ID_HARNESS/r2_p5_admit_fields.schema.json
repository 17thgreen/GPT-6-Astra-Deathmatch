        },
        "holdout_kickoff_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "kalshi_occurrence_datetime": {
          "type": "string"
        },
        "delta_kickoff_sec": {
          "type": [
            "integer",
            "null"
          ],
          "description": "occurrence \u2212 holdout, seconds, signed"
        },
        "window_clock_source": {
          "type": "string",
          "enum": [
            "kalshi_occurrence",
            "holdout_mixed",
